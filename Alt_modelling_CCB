    "# ============================================================\n",
    "# 7. SHAP FEATURE SELECTION WITH CACHE\n",
    "# ============================================================\n",
    "def mean_absolute_shap(\n",
    "    model: CatBoostClassifier,\n",
    "    data: pl.DataFrame,\n",
    "    features: list[str],\n",
    "    categorical: list[str],\n",
    ") -> np.ndarray:\n",
    "    if data.height == 0:\n",
    "        raise ValueError(\n",
    "            \"SHAP-выборка пуста.\"\n",
    "        )\n",
    "    importance_sum = np.zeros(\n",
    "        len(features),\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "    for start in range(\n",
    "        0,\n",
    "        data.height,\n",
    "        SHAP_BATCH,\n",
    "    ):\n",
    "        stop = min(\n",
    "            start + SHAP_BATCH,\n",
    "            data.height,\n",
    "        )\n",
    "        batch = data.slice(\n",
    "            start,\n",
    "            stop - start,\n",
    "        )\n",
    "        pool = make_pool(\n",
    "            batch,\n",
    "            features,\n",
    "            categorical,\n",
    "        )\n",
    "        values = (\n",
    "            model.get_feature_importance(\n",
    "                data=pool,\n",
    "                type=\"ShapValues\",\n",
    "            )\n",
    "        )\n",
    "        importance_sum += (\n",
    "            np.abs(\n",
    "                values[:, :-1]\n",
    "            )\n",
    "            .sum(axis=0)\n",
    "        )\n",
    "        del (\n",
    "            batch,\n",
    "            pool,\n",
    "            values,\n",
    "        )\n",
    "        gc.collect()\n",
    "    return (\n",
    "        importance_sum\n",
    "        / data.height\n",
    "    )\n",
    "def load_selected_features(\n",
    ") -> tuple[list[str], list[str]] | None:\n",
    "    if FORCE_SHAP:\n",
    "        print(\n",
    "            \"[SHAP] FORCE_SHAP=True — \"\n",
    "            \"запускается новый расчёт.\"\n",
    "        )\n",
    "        return None\n",
    "    print(\n",
    "        f\"[SHAP] Поиск кэша: \"\n",
    "        f\"{FEATURES_PATH.resolve()}\"\n",
    "    )\n",
    "    saved = None\n",
    "    if FEATURES_PATH.exists():\n",
    "        try:\n",
    "            with FEATURES_PATH.open(\n",
    "                encoding=\"utf-8\"\n",
    "            ) as file:\n",
    "                saved = json.load(\n",
    "                    file\n",
    "                )\n",
    "        except (\n",
    "            OSError,\n",
    "            json.JSONDecodeError,\n",
    "        ) as error:\n",
    "            print(\n",
    "                \"[SHAP] Не удалось прочитать \"\n",
    "                \"selected_features.json: \"\n",
    "                f\"{error}\"\n",
    "            )\n",
    "    # Резервный источник.\n",
    "    if saved is None:\n",
    "        metadata_path = (\n",
    "            OUT\n",
    "            / \"model_metadata.joblib\"\n",
    "        )\n",
    "        if metadata_path.exists():\n",
    "            try:\n",
    "                saved = joblib.load(\n",
    "                    metadata_path\n",
    "                )\n",
    "                print(\n",
    "                    \"[SHAP] Признаки загружены \"\n",
    "                    \"из model_metadata.joblib.\"\n",
    "                )\n",
    "            except Exception as error:\n",
    "                print(\n",
    "                    \"[SHAP] Ошибка чтения \"\n",
    "                    \"model_metadata.joblib: \"\n",
    "                    f\"{error}\"\n",
    "                )\n",
    "    if saved is None:\n",
    "        print(\n",
    "            \"[SHAP] Кэш не найден — \"\n",
    "            \"требуется новый расчёт.\"\n",
    "        )\n",
    "        return None\n",
    "    selected = first_nonempty(\n",
    "        saved,\n",
    "        \"selected_features\",\n",
    "        \"features\",\n",
    "        \"feature_columns\",\n",
    "    )\n",
    "    selected_cat = first_nonempty(\n",
    "        saved,\n",
    "        \"selected_cat_features\",\n",
    "        \"selected_categorical\",\n",
    "        \"cat_features\",\n",
    "        \"categorical_features\",\n",
    "    )\n",
    "    if not selected:\n",
    "        print(\n",
    "            \"[SHAP] В кэше отсутствует \"\n",
    "            \"selected_features. \"\n",
    "            f\"Доступные ключи: \"\n",
    "            f\"{sorted(saved)}\"\n",
    "        )\n",
    "        return None\n",
    "    selected = unique_list(\n",
    "        selected\n",
    "    )\n",
    "    if selected_cat is None:\n",
    "        categorical_set = set(\n",
    "            categorical_features\n",
    "        )\n",
    "        selected_cat = [\n",
    "            feature\n",
    "            for feature in selected\n",
    "            if feature in categorical_set\n",
    "        ]\n",
    "    else:\n",
    "        selected_cat = [\n",
    "            feature\n",
    "            for feature\n",
    "            in unique_list(\n",
    "                selected_cat\n",
    "            )\n",
    "            if feature in selected\n",
    "        ]\n",
    "    unavailable = [\n",
    "        feature\n",
    "        for feature in selected\n",
    "        if feature not in feature_columns\n",
    "    ]\n",
    "    if unavailable:\n",
    "        print(\n",
    "            \"[SHAP] Сохранённые признаки \"\n",
    "            \"отсутствуют в текущем профиле:\\n\"\n",
    "            + \"\\n\".join(\n",
    "                unavailable[:20]\n",
    "            )\n",
    "        )\n",
    "        return None\n",
    "    save_json(\n",
    "        FEATURES_PATH,\n",
    "        {\n",
    "            \"selected_features\":\n",
    "                selected,\n",
    "            \"selected_cat_features\":\n",
    "                selected_cat,\n",
    "            \"selected_features_count\":\n",
    "                len(selected),\n",
    "        },\n",
    "    )\n",
    "    print(\n",
    "        \"[SHAP] Используется \"\n",
    "        \"сохранённый список.\\n\"\n",
    "        f\"[SHAP] Признаков: \"\n",
    "        f\"{len(selected)}\\n\"\n",
    "        f\"[SHAP] Категориальных: \"\n",
    "        f\"{len(selected_cat)}\"\n",
    "    )\n",
    "    return (\n",
    "        selected,\n",
    "        selected_cat,\n",
    "    )\n",
    "saved_features = (\n",
    "    load_selected_features()\n",
    ")\n",
    "if saved_features is not None:\n",
    "    (\n",
    "        selected_features,\n",
    "        selected_cat_features,\n",
    "    ) = saved_features\n",
    "else:\n",
    "    print(\n",
    "        \"\\n[SHAP] Загрузка train\"\n",
    "    )\n",
    "    importance_data = load_frame(\n",
    "        PATHS[\"train\"],\n",
    "        feature_columns,\n",
    "        preprocess_rules,\n",
    "        IMPORTANCE_ROWS,\n",
    "    )\n",
    "    importance_target = (\n",
    "        to_target(\n",
    "            importance_data\n",
    "        )\n",
    "    )\n",
    "    base_params = {\n",
    "        \"loss_function\":\n",
    "            \"Logloss\",\n",
    "        \"eval_metric\":\n",
    "            \"PRAUC\",\n",
    "        \"iterations\":\n",
    "            BASE_ITERATIONS,\n",
    "        \"learning_rate\":\n",
    "            0.035,\n",
    "        \"depth\":\n",
    "            5,\n",
    "        \"l2_leaf_reg\":\n",
    "            50.0,\n",
    "        \"random_strength\":\n",
    "            10.0,\n",
    "        \"bootstrap_type\":\n",
    "            \"Bayesian\",\n",
    "        \"bagging_temperature\":\n",
    "            2.0,\n",
    "        \"border_count\":\n",
    "            64,\n",
    "        \"scale_pos_weight\":\n",
    "            calculate_scale_pos_weight(\n",
    "                importance_target\n",
    "            ),\n",
    "        \"leaf_estimation_iterations\":\n",
    "            1,\n",
    "        \"one_hot_max_size\":\n",
    "            5,\n",
    "        \"model_size_reg\":\n",
    "            1.0,\n",
    "        \"random_seed\":\n",
    "            SEED,\n",
    "        \"allow_writing_files\":\n",
    "            False,\n",
    "        \"verbose\":\n",
    "            100,\n",
    "    }\n",
    "    shap_data = (\n",
    "        importance_data.sample(\n",
    "            n=min(\n",
    "                SHAP_ROWS,\n",
    "                importance_data.height,\n",
    "            ),\n",
    "            seed=SEED,\n",
    "        )\n",
    "    )\n",
    "    importance_pool = make_pool(\n",
    "        importance_data,\n",
    "        feature_columns,\n",
    "        categorical_features,\n",
    "    )\n",
    "    release(\n",
    "        \"importance_data\",\n",
    "        \"importance_target\",\n",
    "    )\n",
    "    print(\n",
    "        \"[SHAP] Обучение \"\n",
    "        \"предварительной модели\"\n",
    "    )\n",
    "    base_model = fit_catboost(\n",
    "        base_params,\n",
    "        importance_pool,\n",
    "    )\n",
    "    release(\n",
    "        \"importance_pool\"\n",
    "    )\n",
    "    print(\n",
    "        \"[SHAP] Расчёт SHAP\"\n",
    "    )\n",
    "    shap_importance = (\n",
    "        mean_absolute_shap(\n",
    "            base_model,\n",
    "            shap_data,\n",
    "            feature_columns,\n",
    "            categorical_features,\n",
    "        )\n",
    "    )\n",
    "    categorical_set = set(\n",
    "        categorical_features\n",
    "    )\n",
    "    shap_ranking = (\n",
    "        pd.DataFrame({\n",
    "            \"feature\":\n",
    "                feature_columns,\n",
    "            \"shap_importance\":\n",
    "                shap_importance,\n",
    "            \"is_categorical\": [\n",
    "                feature\n",
    "                in categorical_set\n",
    "                for feature\n",
    "                in feature_columns\n",
    "            ],\n",
    "        })\n",
    "        .sort_values(\n",
    "            \"shap_importance\",\n",
    "            ascending=False,\n",
