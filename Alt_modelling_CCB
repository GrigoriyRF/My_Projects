    "    \"border_count\": 128,\n",
    "    \"leaf_estimation_iterations\": 3,\n",
    "    \"one_hot_max_size\": 2,\n",
    "    \"model_size_reg\": 4.738128703455816,\n",
    "    \"subsample\": 0.8904811515927347,\n",
    "}\n",
    "\n",
    "\n",
    "def load_baseline_params() -> dict:\n",
    "    \"\"\"Параметры лучшего trial первого широкого поиска.\"\"\"\n",
    "    params = dict(BASELINE_DEFAULT_PARAMS)\n",
    "\n",
    "    if not BASELINE_OPTUNA_CACHE_PATH.exists():\n",
    "        print(\n",
    "            \"[OPTUNA REFINE] Исходный best_trial.json не найден. \"\n",
    "            \"Используется встроенный baseline.\"\n",
    "        )\n",
    "        return params\n",
    "\n",
    "    try:\n",
    "        with BASELINE_OPTUNA_CACHE_PATH.open(\n",
    "            \"r\",\n",
    "            encoding=\"utf-8\",\n",
    "        ) as file:\n",
    "            cached = json.load(file)\n",
    "\n",
    "        source_params = (\n",
    "            cached.get(\"params\")\n",
    "            or cached.get(\"trial_params\")\n",
    "            or {}\n",
    "        )\n",
    "        params.update(source_params)\n",
    "\n",
    "        print(\n",
    "            \"[OPTUNA REFINE] Baseline загружен из \"\n",
    "            f\"{BASELINE_OPTUNA_CACHE_PATH.resolve()}\"\n",
    "        )\n",
    "        return params\n",
    "\n",
    "    except (OSError, json.JSONDecodeError) as error:\n",
    "        print(\n",
    "            \"[OPTUNA REFINE] Не удалось прочитать baseline: \"\n",
    "            f\"{error}. Используется встроенный baseline.\"\n",
    "        )\n",
    "        return params\n",
    "\n",
    "\n",
    "BASELINE_PARAMS = load_baseline_params()\n",
    "\n",
    "# Параметры, которые уже найдены первым поиском и повторно не тюнятся.\n",
    "FIXED_REFINE_PARAMS = {\n",
    "    \"bootstrap_type\": str(\n",
    "        BASELINE_PARAMS.get(\"bootstrap_type\", \"Bernoulli\")\n",
    "    ),\n",
    "    \"border_count\": int(\n",
    "        BASELINE_PARAMS.get(\"border_count\", 128)\n",
    "    ),\n",
    "    \"one_hot_max_size\": int(\n",
    "        BASELINE_PARAMS.get(\"one_hot_max_size\", 2)\n",
    "    ),\n",
    "    \"model_size_reg\": float(\n",
    "        BASELINE_PARAMS.get(\"model_size_reg\", 4.738128703455816)\n",
    "    ),\n",
    "}\n",
    "\n",
    "BASELINE_L2 = float(\n",
    "    BASELINE_PARAMS.get(\"l2_leaf_reg\", 55.0)\n",
    ")\n",
    "BASELINE_RANDOM_STRENGTH = float(\n",
    "    BASELINE_PARAMS.get(\"random_strength\", 8.0)\n",
    ")\n",
    "\n",
    "# Refinement разрешает двигать эти регуляризаторы только в сторону\n",
    "# той же или более сильной регуляризации.\n",
    "REFINE_L2_LOW = min(max(BASELINE_L2, 55.0), 500.0)\n",
    "REFINE_RANDOM_STRENGTH_LOW = min(\n",
    "    max(BASELINE_RANDOM_STRENGTH, 8.0),\n",
    "    40.0,\n",
    ")\n",
    "\n",
    "\n",
    "def load_optuna_cache() -> dict | None:\n",
    "    \"\"\"Кэш именно refinement, baseline best_trial.json не трогаем.\"\"\"\n",
    "    if FORCE_OPTUNA or not OPTUNA_CACHE_PATH.exists():\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        with OPTUNA_CACHE_PATH.open(\n",
    "            encoding=\"utf-8\"\n",
    "        ) as file:\n",
    "            cached = json.load(file)\n",
    "    except (OSError, json.JSONDecodeError) as error:\n",
    "        print(\n",
    "            f\"[OPTUNA REFINE] Кэш повреждён: {error}\"\n",
    "        )\n",
    "        return None\n",
    "\n",
    "    required = {\n",
    "        \"trial_number\",\n",
    "        \"objective\",\n",
    "        \"params\",\n",
    "        \"metrics\",\n",
    "    }\n",
    "    if not required.issubset(cached):\n",
    "        print(\n",
    "            \"[OPTUNA REFINE] best_trial_refine.json \"\n",
    "            \"не содержит обязательных полей.\"\n",
    "        )\n",
    "        return None\n",
    "\n",
    "    cached_target = cached.get(\"target\")\n",
    "    cached_signature = cached.get(\"feature_signature\")\n",
    "\n",
    "    if cached_target is not None and cached_target != TARGET:\n",
    "        return None\n",
    "\n",
    "    if (\n",
    "        cached_signature is not None\n",
    "        and cached_signature != feature_signature\n",
    "    ):\n",
    "        print(\n",
    "            \"[OPTUNA REFINE] Список признаков изменился — \"\n",
    "            \"нужен новый refinement.\"\n",
    "        )\n",
    "        return None\n",
    "\n",
    "    return cached\n",
    "\n",
    "\n",
    "def create_optuna_storage() -> JournalStorage:\n",
    "    \"\"\"\n",
    "    NFS-safe storage для Optuna 4.0.\n",
    "    SQLite не используется.\n",
    "    \"\"\"\n",
    "    journal_path = OPTUNA_STORAGE_PATH.resolve()\n",
    "    journal_path.parent.mkdir(\n",
    "        parents=True,\n",
    "        exist_ok=True,\n",
    "    )\n",
    "\n",
    "    lock_path = Path(str(journal_path) + \".lock\")\n",
    "    if lock_path.exists() or lock_path.is_symlink():\n",
    "        raise RuntimeError(\n",
    "            \"Обнаружен lock-файл Optuna:\\n\"\n",
    "            f\"{lock_path}\\n\\n\"\n",
    "            \"Если другой процесс Optuna работает — не удаляйте его. \"\n",
    "            \"Если предыдущий процесс аварийно завершился и lock точно \"\n",
    "            \"устарел, удалите только этот .lock.\"\n",
    "        )\n",
    "\n",
    "    backend = JournalFileBackend(\n",
    "        file_path=str(journal_path),\n",
    "        lock_obj=JournalFileSymlinkLock(\n",
    "            str(journal_path)\n",
    "        ),\n",
    "    )\n",
    "    return JournalStorage(backend)\n",
    "\n",
    "\n",
    "def print_trial_summary(\n",
    "    prefix: str,\n",
    "    trial,\n",
    ") -> None:\n",
    "    attrs = trial.user_attrs\n",
    "    print(\n",
    "        f\"\\n{prefix}\\n\"\n",
    "        f\"Trial: {trial.number}\\n\"\n",
    "        f\"Objective: {trial.value:.6f}\\n\"\n",
    "        f\"Train Gini: \"\n",
    "        f\"{attrs.get('train_gini', np.nan):.6f}\\n\"\n",
    "        f\"Valid Gini: \"\n",
    "        f\"{attrs.get('valid_gini', np.nan):.6f}\\n\"\n",
    "        f\"Valid PR-AUC: \"\n",
    "        f\"{attrs.get('valid_pr_auc', np.nan):.6f}\\n\"\n",
    "        f\"Gini Gap: \"\n",
    "        f\"{attrs.get('train_valid_gini_gap', np.nan):.6f}\\n\"\n",
    "        f\"Gap excess: \"\n",
    "        f\"{attrs.get('gap_excess', np.nan):.6f}\\n\"\n",
    "        f\"Best iteration: \"\n",
    "        f\"{'best_iteration'}\"\n",
    "    )\n",
    "\n",
    "\n",
    "cached_trial = load_optuna_cache()\n",
    "\n",
    "if cached_trial is not None:\n",
    "    best_params = dict(\n",
    "        cached_trial[\"params\"]\n",
    "    )\n",
    "    best_trial = SimpleNamespace(\n",
    "        number=int(\n",
    "            cached_trial[\"trial_number\"]\n",
    "        ),\n",
    "        value=float(\n",
    "            cached_trial[\"objective\"]\n",
    "        ),\n",
    "        params=dict(\n",
    "            cached_trial.get(\n",
    "                \"trial_params\",\n",
    "                {},\n",
    "            )\n",
    "        ),\n",
    "        user_attrs=dict(\n",
    "            cached_trial[\"metrics\"]\n",
    "        ),\n",
    "    )\n",
    "    print_trial_summary(\n",
    "        \"[OPTUNA REFINE] Используются \"\n",
    "        \"сохранённые параметры refinement.\",\n",
    "        best_trial,\n",
    "    )\n",
    "\n",
    "else:\n",
    "    print(\n",
    "        \"\\n[OPTUNA REFINE] Загрузка полного train и valid\"\n",
    "    )\n",
    "\n",
    "    train_tune = load_frame(\n",
    "        PATHS[\"train\"],\n",
    "        selected_features,\n",
    "        preprocess_rules,\n",
    "        TUNE_TRAIN_ROWS,\n",
    "    )\n",
    "    valid_tune = load_frame(\n",
    "        PATHS[\"valid\"],\n",
    "        selected_features,\n",
    "        preprocess_rules,\n",
    "        TUNE_VALID_ROWS,\n",
    "    )\n",
    "\n",
    "    y_train_tune = to_target(train_tune)\n",
    "    y_valid_tune = to_target(valid_tune)\n",
    "\n",
    "    if np.unique(y_train_tune).size < 2:\n",
    "        raise ValueError(\n",
    "            \"В train отсутствует один из классов.\"\n",
    "        )\n",
    "    if np.unique(y_valid_tune).size < 2:\n",
    "        raise ValueError(\n",
    "            \"В valid отсутствует один из классов.\"\n",
    "        )\n",
    "\n",
    "    tune_scale_pos_weight = (\n",
    "        calculate_scale_pos_weight(\n",
    "            y_train_tune\n",
    "        )\n",
    "    )\n",
    "\n",
    "    train_tune_pool = make_pool(\n",
    "        train_tune,\n",
    "        selected_features,\n",
    "        selected_cat_features,\n",
    "    )\n",
    "    valid_tune_pool = make_pool(\n",
    "        valid_tune,\n",
    "        selected_features,\n",
    "        selected_cat_features,\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"[OPTUNA REFINE] Train rows: {len(y_train_tune):,}; \"\n",
    "        f\"Valid rows: {len(y_valid_tune):,}\"\n",
    "    )\n",
    "    release(\n",
    "        \"train_tune\",\n",
    "        \"valid_tune\",\n",
    "    )\n",
    "\n",
    "    def optuna_objective(\n",
    "        trial: optuna.Trial,\n",
    "    ) -> float:\n",
    "        params = {\n",
    "            \"loss_function\": \"Logloss\",\n",
    "            \"eval_metric\": \"PRAUC\",\n",
    "            **FIXED_REFINE_PARAMS,\n",
    "\n",
    "            # Было 1900. Ищем ту же или меньшую ёмкость.\n",
    "            \"iterations\": trial.suggest_int(\n",
    "                \"iterations\",\n",
    "                700,\n",
    "                1900,\n",
    "                step=100,\n",
    "            ),\n",
    "\n",
    "            # Было ~0.0508. Не увеличиваем learning rate.\n",
    "            \"learning_rate\": trial.suggest_float(\n",
    "                \"learning_rate\",\n",
    "                0.020,\n",
    "                0.050,\n",
    "                log=True,\n",
    "            ),\n",
    "\n",
    "            # Было depth=6. Более глубокие деревья исключаем.\n",
    "            \"depth\": trial.suggest_int(\n",
    "                \"depth\",\n",
    "                3,\n",
    "                5,\n",
    "            ),\n",
    "\n",
    "            # Не ослабляем L2 относительно baseline.\n",
    "            \"l2_leaf_reg\": trial.suggest_float(\n",
    "                \"l2_leaf_reg\",\n",
    "                REFINE_L2_LOW,\n",
    "                500.0,\n",
    "                log=True,\n",
    "            ),\n",
    "\n",
    "            # Не уменьшаем random_strength относительно baseline.\n",
    "            \"random_strength\": trial.suggest_float(\n",
    "                \"random_strength\",\n",
    "                REFINE_RANDOM_STRENGTH_LOW,\n",
    "                40.0,\n",
    "            ),\n",
    "\n",
    "            # Было 3. Разрешаем то же или меньше.\n",
    "            \"leaf_estimation_iterations\": trial.suggest_int(\n",
    "                \"leaf_estimation_iterations\",\n",
    "                1,\n",
    "                3,\n",
    "            ),\n",
    "\n",
    "            \"scale_pos_weight\": tune_scale_pos_weight,\n",
    "            \"random_seed\": SEED,\n",
    "            \"allow_writing_files\": False,\n",
    "            \"verbose\": False,\n",
    "        }\n",
    "\n",
    "        if FIXED_REFINE_PARAMS[\"bootstrap_type\"] == \"Bernoulli\":\n",
    "            # Было ~0.89; верхнюю область исключаем.\n",
    "            params[\"subsample\"] = trial.suggest_float(\n",
    "                \"subsample\",\n",
    "                0.55,\n",
    "                0.85,\n",
    "            )\n",
    "        elif FIXED_REFINE_PARAMS[\"bootstrap_type\"] == \"Bayesian\":\n",
    "            # На случай другого baseline сохраняем совместимость.\n",
    "            baseline_temperature = float(\n",
    "                BASELINE_PARAMS.get(\n",
    "                    \"bagging_temperature\",\n",
    "                    2.0,\n",
    "                )\n",
    "            )\n",
    "            params[\"bagging_temperature\"] = trial.suggest_float(\n",
    "                \"bagging_temperature\",\n",
    "                max(0.5, baseline_temperature),\n",
    "                max(5.0, baseline_temperature),\n",
    "            )\n",
    "\n",
    "        model = fit_catboost(\n",
    "            params,\n",
    "            train_tune_pool,\n",
    "            valid_tune_pool,\n",
    "            OPTUNA_EARLY_STOPPING,\n",
    "        )\n",
    "\n",
    "        train_score = model.predict_proba(\n",
    "            train_tune_pool\n",
    "        )[:, 1]\n",
    "        valid_score = model.predict_proba(\n",
    "            valid_tune_pool\n",
    "        )[:, 1]\n",
    "\n",
    "        train_gini = gini_from_scores(\n",
    "            y_train_tune,\n",
    "            train_score,\n",
    "        )\n",
    "        valid_gini = gini_from_scores(\n",
    "            y_valid_tune,\n",
    "            valid_score,\n",
    "        )\n",
    "        valid_pr_auc = float(\n",
    "            average_precision_score(\n",
    "                y_valid_tune,\n",
    "                valid_score,\n",
    "            )\n",
    "        )\n",
    "\n",
    "        gini_gap = max(\n",
    "            0.0,\n",
    "            train_gini - valid_gini,\n",
    "        )\n",
    "        gap_excess = max(\n",
    "            0.0,\n",
    "            gini_gap - TARGET_GINI_GAP,\n",
    "        )\n",
    "\n",
    "        # В отличие от первого поиска gap теперь влияет на objective,\n",
    "        # а не только отсекается после подбора.\n",
    "        objective = (\n",
    "            valid_pr_auc\n",
    "            + 0.10 * valid_gini\n",
    "            - GAP_PENALTY * gap_excess\n",
    "        )\n",
    "\n",
    "        best_iteration = (\n",
    "            model.get_best_iteration()\n",
    "        )\n",
    "        if best_iteration < 0:\n",
    "            best_iteration = (\n",
    "                model.tree_count_ - 1\n",
    "            )\n",
    "\n",
    "        trial_metrics = {\n",
    "            \"train_gini\": float(train_gini),\n",
    "            \"valid_gini\": float(valid_gini),\n",
    "            \"valid_pr_auc\": float(valid_pr_auc),\n",
    "            \"train_valid_gini_gap\": float(gini_gap),\n",
    "            \"gap_excess\": float(gap_excess),\n",
    "            \"best_iteration\": int(best_iteration),\n",
    "        }\n",
    "\n",
    "        for name, value in trial_metrics.items():\n",
    "            trial.set_user_attr(name, value)\n",
    "\n",
    "        del model, train_score, valid_score\n",
    "        gc.collect()\n",
    "\n",
    "        if not np.isfinite(objective):\n",
    "            raise optuna.TrialPruned(\n",
    "                \"Objective не является конечным числом.\"\n",
    "            )\n",
    "\n",
    "        return float(objective)\n",
    "\n",
    "    def gini_gap_constraint(\n",
    "        trial: optuna.trial.FrozenTrial,\n",
    "    ) -> tuple[float]:\n",
    "        gap = trial.user_attrs.get(\n",
    "            \"train_valid_gini_gap\"\n",
    "        )\n",
    "        if gap is None or not np.isfinite(gap):\n",
    "            return (1.0,)\n",
    "        return (\n",
    "            float(gap - MAX_GINI_GAP),\n",
    "        )\n",
    "\n",
    "    sampler = optuna.samplers.TPESampler(\n",
    "        seed=SEED,\n",
    "        n_startup_trials=5,\n",
    "        multivariate=True,\n",
    "        group=True,\n",
    "        warn_independent_sampling=False,\n",
    "        constraints_func=gini_gap_constraint,\n",
    "    )\n",
    "\n",
    "    # Стабильное имя: перезапуск ноутбука продолжает тот же refinement.\n",
    "    study_name = (\n",
    "        f\"catboost_refine_{TARGET}_\"\n",
    "        f\"{feature_signature[:12]}_\"\n",
    "        f\"{OPTUNA_RUN_TAG}\"\n",
    "    )\n",
    "\n",
    "    study = optuna.create_study(\n",
    "        study_name=study_name,\n",
    "        storage=create_optuna_storage(),\n",
    "        direction=\"maximize\",\n",
    "        sampler=sampler,\n",
    "        load_if_exists=True,\n",
    "    )\n",
    "\n",
    "    # Первый trial — консервативная проекция предыдущего optimum\n",
    "    # в новое anti-overfit пространство поиска.\n",
    "    if not study.trials:\n",
    "        initial_trial = {\n",
    "            \"iterations\": int(\n",
    "                np.clip(\n",
    "                    BASELINE_PARAMS.get(\"iterations\", 1900),\n",
    "                    700,\n",
    "                    1900,\n",
    "                )\n",
    "            ),\n",
    "            \"learning_rate\": float(\n",
    "                np.clip(\n",
    "                    BASELINE_PARAMS.get(\"learning_rate\", 0.05),\n",
    "                    0.020,\n",
    "                    0.050,\n",
    "                )\n",
    "            ),\n",
    "            \"depth\": int(\n",
    "                np.clip(\n",
    "                    BASELINE_PARAMS.get(\"depth\", 6),\n",
    "                    3,\n",
    "                    5,\n",
    "                )\n",
    "            ),\n",
    "            \"l2_leaf_reg\": float(\n",
    "                np.clip(\n",
    "                    BASELINE_L2,\n",
    "                    REFINE_L2_LOW,\n",
    "                    500.0,\n",
    "                )\n",
    "            ),\n",
    "            \"random_strength\": float(\n",
    "                np.clip(\n",
    "                    BASELINE_RANDOM_STRENGTH,\n",
    "                    REFINE_RANDOM_STRENGTH_LOW,\n",
    "                    40.0,\n",
    "                )\n",
    "            ),\n",
    "            \"rsm\": 1.0,\n",
    "            \"leaf_estimation_iterations\": int(\n",
    "                np.clip(\n",
    "                    BASELINE_PARAMS.get(\n",
    "                        \"leaf_estimation_iterations\",\n",
    "                        3,\n",
    "                    ),\n",
    "                    1,\n",
    "                    3,\n",
    "                )\n",
    "            ),\n",
    "        }\n",
    "\n",
    "        if FIXED_REFINE_PARAMS[\"bootstrap_type\"] == \"Bernoulli\":\n",
    "            initial_trial[\"subsample\"] = float(\n",
    "                np.clip(\n",
    "                    BASELINE_PARAMS.get(\"subsample\", 0.85),\n",
    "                    0.55,\n",
    "                    0.85,\n",
    "                )\n",
    "            )\n",
    "\n",
    "        study.enqueue_trial(\n",
    "            initial_trial\n",
    "        )\n",
    "\n",
    "    print(\n",
    "        f\"[OPTUNA REFINE] Study: {study_name}\\n\"\n",
    "        f\"[OPTUNA REFINE] Storage: \"\n",
    "        f\"{OPTUNA_STORAGE_PATH.resolve()}\\n\"\n",
    "        \"[OPTUNA REFINE] Backend: \"\n",
    "        \"JournalStorage + JournalFileSymlinkLock (NFS)\\n\"\n",
    "        f\"[OPTUNA REFINE] Fixed params: {FIXED_REFINE_PARAMS}\"\n",
    "    )\n",
    "\n",
    "    finished_states = {\n",
    "        TrialState.COMPLETE,\n",
    "        TrialState.PRUNED,\n",
    "        TrialState.FAIL,\n",
    "    }\n",
    "    finished_trials = sum(\n",
    "        trial.state in finished_states\n",
    "        for trial in study.trials\n",
    "    )\n",
    "    remaining_trials = max(\n",
    "        0,\n",
    "        N_TRIALS - finished_trials,\n",
    "    )\n",
    "\n",
    "    if remaining_trials:\n",
    "        print(\n",
    "            f\"[OPTUNA REFINE] Завершено: {finished_trials}; \"\n",
    "            f\"осталось: {remaining_trials}\"\n",
    "        )\n",
    "        study.optimize(\n",
    "            optuna_objective,\n",
    "            n_trials=remaining_trials,\n",
    "            n_jobs=1,\n",
    "            show_progress_bar=True,\n",
    "            gc_after_trial=True,\n",
    "            catch=(CatBoostError,),\n",
    "        )\n",
    "    else:\n",
    "        print(\n",
    "            \"[OPTUNA REFINE] Все trials уже присутствуют \"\n",
    "            \"в JournalStorage.\"\n",
    "        )\n",
    "\n",
    "    study.trials_dataframe().to_csv(\n",
    "        OUT / \"optuna_trials_refine.csv\",\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    completed_trials = [\n",
    "        trial\n",
    "        for trial in study.get_trials(\n",
    "            deepcopy=False,\n",
    "            states=(TrialState.COMPLETE,),\n",
    "        )\n",
    "        if (\n",
    "            trial.value is not None\n",
    "            and np.isfinite(trial.value)\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    eligible_trials = [\n",
    "        trial\n",
    "        for trial in completed_trials\n",
    "        if (\n",
    "            trial.user_attrs.get(\n",
    "                \"train_valid_gini_gap\",\n",
    "                np.inf,\n",
    "            )\n",
    "            <= MAX_GINI_GAP\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    if not completed_trials:\n",
    "        raise RuntimeError(\n",
    "            \"Optuna refinement не завершила ни одного trial.\"\n",
    "        )\n",
    "\n",
    "    if not eligible_trials:\n",
    "        minimum_gap = min(\n",
    "            trial.user_attrs.get(\n",
    "                \"train_valid_gini_gap\",\n",
    "                np.inf,\n",
    "            )\n",
    "            for trial in completed_trials\n",
    "        )\n",
    "        raise RuntimeError(\n",
    "            \"Нет refinement trial с допустимым Gini Gap: \"\n",
    "            f\"лимит={MAX_GINI_GAP:.2%}, \"\n",
    "            f\"минимум={minimum_gap:.2%}.\"\n",
    "        )\n",
    "\n",
