    "# ============================================================\n",
    "# 10. PSI\n",
    "# ============================================================\n",
    "def build_psi_reference(\n",
    "    score: np.ndarray,\n",
    ") -> tuple[\n",
    "    np.ndarray,\n",
    "    np.ndarray,\n",
    "]:\n",
    "    score = np.asarray(\n",
    "        score,\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "    edges = np.unique(\n",
    "        np.quantile(\n",
    "            score,\n",
    "            np.linspace(\n",
    "                0,\n",
    "                1,\n",
    "                PSI_BINS + 1,\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "    if len(edges) < 2:\n",
    "        value = float(\n",
    "            score[0]\n",
    "        )\n",
    "        edges = np.array([\n",
    "            value - 1e-6,\n",
    "            value + 1e-6,\n",
    "        ])\n",
    "    edges[0] = -np.inf\n",
    "    edges[-1] = np.inf\n",
    "    counts = (\n",
    "        np.histogram(\n",
    "            score,\n",
    "            bins=edges,\n",
    "        )[0]\n",
    "        .astype(\n",
    "            np.float64\n",
    "        )\n",
    "    )\n",
    "    return (\n",
    "        edges,\n",
    "        counts / counts.sum(),\n",
    "    )\n",
    "def calculate_psi(\n",
    "    reference_distribution: np.ndarray,\n",
    "    score: np.ndarray,\n",
    "    edges: np.ndarray,\n",
    "    epsilon: float = 1e-6,\n",
    ") -> float:\n",
    "    actual = (\n",
    "        np.histogram(\n",
    "            score,\n",
    "            bins=edges,\n",
    "        )[0]\n",
    "        .astype(\n",
    "            np.float64\n",
    "        )\n",
    "    )\n",
    "    actual /= actual.sum()\n",
    "    reference = np.clip(\n",
    "        reference_distribution,\n",
    "        epsilon,\n",
    "        None,\n",
    "    )\n",
    "    actual = np.clip(\n",
    "        actual,\n",
    "        epsilon,\n",
    "        None,\n",
    "    )\n",
    "    return float(\n",
    "        np.sum(\n",
    "            (\n",
    "                actual\n",
    "                - reference\n",
    "            )\n",
    "            * np.log(\n",
    "                actual\n",
    "                / reference\n",
    "            )\n",
    "        )\n",
    "    )"
   ]
