    "# ============================================================\n",
    "# 11. BOOTSTRAP\n",
    "# ============================================================\n",
    "def bootstrap_ranking_metrics(\n",
    "    target: np.ndarray,\n",
    "    score: np.ndarray,\n",
    "    sample_name: str,\n",
    ") -> pd.DataFrame:\n",
    "    target = np.asarray(\n",
    "        target,\n",
    "        dtype=np.int8,\n",
    "    )\n",
    "    score = np.asarray(\n",
    "        score,\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "    positive = np.flatnonzero(\n",
    "        target == 1\n",
    "    )\n",
    "    negative = np.flatnonzero(\n",
    "        target == 0\n",
    "    )\n",
    "    metric_names = (\n",
    "        \"roc_auc\",\n",
    "        \"gini\",\n",
    "        \"pr_auc\",\n",
    "    )\n",
    "    if (\n",
    "        not len(positive)\n",
    "        or not len(negative)\n",
    "    ):\n",
    "        return pd.DataFrame({\n",
    "            \"sample\":\n",
    "                sample_name,\n",
    "            \"metric\":\n",
    "                metric_names,\n",
    "            \"ci_low\":\n",
    "                np.nan,\n",
    "            \"ci_high\":\n",
    "                np.nan,\n",
    "            \"bootstrap_mean\":\n",
    "                np.nan,\n",
    "            \"bootstrap_std\":\n",
    "                np.nan,\n",
    "            \"n_bootstrap\":\n",
    "                0,\n",
    "            \"confidence_level\":\n",
    "                1\n",
    "                - BOOTSTRAP_ALPHA,\n",
    "            \"negative_cap\":\n",
    "                BOOTSTRAP_NEGATIVE_CAP,\n",
    "        })\n",
    "    negative_size = (\n",
    "        len(negative)\n",
    "        if BOOTSTRAP_NEGATIVE_CAP\n",
    "        is None\n",
    "        else min(\n",
    "            len(negative),\n",
    "            BOOTSTRAP_NEGATIVE_CAP,\n",
    "        )\n",
    "    )\n",
    "    negative_weight = (\n",
    "        len(negative)\n",
    "        / negative_size\n",
    "    )\n",
    "    rng = np.random.default_rng(\n",
    "        SEED\n",
    "        + sum(\n",
    "            map(\n",
    "                ord,\n",
    "                sample_name,\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "    values = np.empty(\n",
    "        (\n",
    "            BOOTSTRAP_N,\n",
    "            3,\n",
    "        ),\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "    for index in range(\n",
    "        BOOTSTRAP_N\n",
    "    ):\n",
    "        positive_idx = rng.choice(\n",
    "            positive,\n",
    "            len(positive),\n",
    "            replace=True,\n",
    "        )\n",
    "        negative_idx = rng.choice(\n",
    "            negative,\n",
    "            negative_size,\n",
    "            replace=True,\n",
    "        )\n",
    "        bootstrap_idx = np.concatenate((\n",
    "            positive_idx,\n",
    "            negative_idx,\n",
    "        ))\n",
    "        bootstrap_target = (\n",
    "            target[\n",
    "                bootstrap_idx\n",
    "            ]\n",
    "        )\n",
    "        bootstrap_score = (\n",
    "            score[\n",
    "                bootstrap_idx\n",
    "            ]\n",
    "        )\n",
    "        weights = np.concatenate((\n",
    "            np.ones(\n",
    "                len(\n",
    "                    positive_idx\n",
    "                )\n",
    "            ),\n",
    "            np.full(\n",
    "                len(\n",
    "                    negative_idx\n",
    "                ),\n",
    "                negative_weight,\n",
    "            ),\n",
    "        ))\n",
    "        auc = roc_auc_score(\n",
    "            bootstrap_target,\n",
    "            bootstrap_score,\n",
    "            sample_weight=weights,\n",
    "        )\n",
    "        pr_auc = (\n",
    "            average_precision_score(\n",
    "                bootstrap_target,\n",
    "                bootstrap_score,\n",
    "                sample_weight=weights,\n",
    "            )\n",
    "        )\n",
    "        values[index] = (\n",
    "            auc,\n",
    "            2 * auc - 1,\n",
    "            pr_auc,\n",
    "        )\n",
    "    percentile_low = (\n",
    "        100\n",
    "        * BOOTSTRAP_ALPHA\n",
    "        / 2\n",
    "    )\n",
    "    percentile_high = (\n",
    "        100\n",
    "        * (\n",
    "            1\n",
    "            - BOOTSTRAP_ALPHA\n",
    "            / 2\n",
    "        )\n",
    "    )\n",
    "    rows = []\n",
    "    for (\n",
    "        column,\n",
    "        metric_name,\n",
    "    ) in enumerate(\n",
    "        metric_names\n",
    "    ):\n",
    "        metric_values = (\n",
    "            values[:, column]\n",
    "        )\n",
    "        rows.append({\n",
    "            \"sample\":\n",
    "                sample_name,\n",
    "            \"metric\":\n",
    "                metric_name,\n",
    "            \"ci_low\":\n",
    "                float(\n",
    "                    np.percentile(\n",
    "                        metric_values,\n",
    "                        percentile_low,\n",
    "                    )\n",
    "                ),\n",
    "            \"ci_high\":\n",
    "                float(\n",
    "                    np.percentile(\n",
    "                        metric_values,\n",
    "                        percentile_high,\n",
    "                    )\n",
    "                ),\n",
    "            \"bootstrap_mean\":\n",
    "                float(\n",
    "                    metric_values.mean()\n",
    "                ),\n",
    "            \"bootstrap_std\":\n",
    "                float(\n",
    "                    metric_values.std(\n",
    "                        ddof=1\n",
    "                    )\n",
    "                ),\n",
    "            \"n_bootstrap\":\n",
    "                BOOTSTRAP_N,\n",
    "            \"confidence_level\":\n",
    "                1\n",
    "                - BOOTSTRAP_ALPHA,\n",
    "            \"negative_cap\":\n",
    "                BOOTSTRAP_NEGATIVE_CAP,\n",
    "        })\n",
    "    return pd.DataFrame(\n",
    "        rows\n",
    "    )"
   ]
