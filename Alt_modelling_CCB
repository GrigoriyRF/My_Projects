    "    sample_data = load_frame(\n",
    "        PATHS[\n",
    "            sample_name\n",
    "        ],\n",
    "        selected_features,\n",
    "        preprocess_rules,\n",
    "        extra_columns=INFO,\n",
    "    )\n",
    "    target = (\n",
    "        to_target(\n",
    "            sample_data\n",
    "        )\n",
    "    )\n",
    "    score = predict_batched(\n",
    "        final_model,\n",
    "        sample_data,\n",
    "        selected_features,\n",
    "        selected_cat_features,\n",
    "    )\n",
    "    if sample_name == \"train\":\n",
    "        (\n",
    "            psi_edges,\n",
    "            psi_reference,\n",
    "        ) = build_psi_reference(\n",
    "            score\n",
    "        )\n",
    "        score_psi = 0.0\n",
    "    else:\n",
    "        score_psi = calculate_psi(\n",
    "            psi_reference,\n",
    "            score,\n",
    "            psi_edges,\n",
    "        )\n",
    "    ranking = ranking_metrics(\n",
    "        target,\n",
    "        score,\n",
    "    )\n",
    "    threshold = threshold_metrics(\n",
    "        target,\n",
    "        score,\n",
    "    )\n",
    "    point_rows.append({\n",
    "        \"sample\":\n",
    "            sample_name,\n",
    "        \"target_col\":\n",
    "            TARGET,\n",
    "        **ranking,\n",
    "        **threshold,\n",
    "        \"psi_vs_train\":\n",
    "            score_psi,\n",
    "    })\n",
    "    output_columns = [\n",
    "        column\n",
    "        for column\n",
    "        in (\n",
    "            INFO\n",
    "            + [TARGET]\n",
    "        )\n",
    "        if column\n",
    "        in sample_data.columns\n",
    "    ]\n",
    "    (\n",
    "        sample_data\n",
    "        .select(\n",
    "            output_columns\n",
    "        )\n",
    "        .with_columns(\n",
    "            pl.Series(\n",
    "                name=SCORE_COLUMN,\n",
    "                values=score,\n",
    "                dtype=pl.Float32,\n",
    "            )\n",
    "        )\n",
    "        .write_parquet(\n",
    "            OUT\n",
    "            / (\n",
    "                f\"scores_\"\n",
    "                f\"{sample_name}\"\n",
    "                f\".parquet\"\n",
    "            ),\n",
    "            compression=\"zstd\",\n",
    "        )\n",
    "    )\n",
    "    # Освобождаем полный DataFrame\n",
    "    # до тяжёлого bootstrap.\n",
    "    release(\n",
    "        \"sample_data\"\n",
    "    )\n",
    "    bootstrap_parts.append(\n",
    "        bootstrap_ranking_metrics(\n",
    "            target,\n",
    "            score,\n",
    "            sample_name,\n",
    "        )\n",
    "    )\n",
    "    print(\n",
    "        f\"{sample_name}: \"\n",
    "        f\"Gini=\"\n",
    "        f\"{ranking['gini']:.6f}; \"\n",
    "        f\"ROC-AUC=\"\n",
    "        f\"{ranking['roc_auc']:.6f}; \"\n",
    "        f\"PR-AUC=\"\n",
    "        f\"{ranking['pr_auc']:.6f}; \"\n",
    "        f\"PSI=\"\n",
    "        f\"{score_psi:.6f}\"\n",
    "    )\n",
    "    release(\n",
    "        \"target\",\n",
    "        \"score\",\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
