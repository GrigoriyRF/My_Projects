    "# ============================================================\n",
    "# 5. PREPROCESSING / CATBOOST I/O\n",
    "# ============================================================\n",
    "def preprocess(\n",
    "    data: pl.DataFrame,\n",
    "    features: list[str],\n",
    "    rules: dict,\n",
    ") -> pl.DataFrame:\n",
    "    if TARGET not in data.columns:\n",
    "        raise KeyError(\n",
    "            f\"В данных отсутствует таргет \"\n",
    "            f\"{TARGET!r}.\"\n",
    "        )\n",
    "    numeric = set(\n",
    "        rules[\"numeric_features\"]\n",
    "    )\n",
    "    pseudo_numeric = set(\n",
    "        rules[\"pseudo_numeric_features\"]\n",
    "    )\n",
    "    dates = set(\n",
    "        rules[\"date_features\"]\n",
    "    )\n",
    "    categorical = set(\n",
    "        rules[\n",
    "            \"catboost_categorical_features\"\n",
    "        ]\n",
    "    )\n",
    "    missing_columns = [\n",
    "        column\n",
    "        for column in features\n",
    "        if column not in data.columns\n",
    "    ]\n",
    "    if missing_columns:\n",
    "        data = data.with_columns([\n",
    "            (\n",
    "                pl.lit(\n",
    "                    MISSING_CAT,\n",
    "                    dtype=pl.String,\n",
    "                )\n",
    "                if column in categorical\n",
    "                else pl.lit(\n",
    "                    None,\n",
    "                    dtype=pl.Float32,\n",
    "                )\n",
    "            ).alias(column)\n",
    "            for column\n",
    "            in missing_columns\n",
    "        ])\n",
    "    expressions = []\n",
    "    for column in features:\n",
    "        if column in numeric:\n",
    "            expression = (\n",
    "                pl.col(column)\n",
    "                .cast(\n",
    "                    pl.Float32,\n",
    "                    strict=False,\n",
    "                )\n",
    "            )\n",
    "        elif column in pseudo_numeric:\n",
    "            expression = (\n",
    "                pl.col(column)\n",
    "                .cast(\n",
    "                    pl.String,\n",
    "                    strict=False,\n",
    "                )\n",
    "                .str.replace_all(\n",
    "                    \",\",\n",
    "                    \".\",\n",
    "                )\n",
    "                .cast(\n",
    "                    pl.Float32,\n",
    "                    strict=False,\n",
    "                )\n",
    "            )\n",
    "        elif column in dates:\n",
    "            expression = (\n",
    "                pl.col(column)\n",
    "                .cast(\n",
    "                    pl.Date,\n",
    "                    strict=False,\n",
    "                )\n",
    "                .cast(\n",
    "                    pl.Int32,\n",
    "                    strict=False,\n",
    "                )\n",
    "                .cast(\n",
    "                    pl.Float32,\n",
    "                    strict=False,\n",
    "                )\n",
    "            )\n",
    "        elif column in categorical:\n",
    "            expression = (\n",
    "                pl.when(\n",
    "                    missing_expr(column)\n",
    "                )\n",
    "                .then(\n",
    "                    pl.lit(\n",
    "                        MISSING_CAT\n",
    "                    )\n",
    "                )\n",
    "                .otherwise(\n",
    "                    pl.col(column)\n",
    "                    .cast(\n",
    "                        pl.String,\n",
    "                        strict=False,\n",
    "                    )\n",
    "                )\n",
    "            )\n",
    "        else:\n",
    "            expression = (\n",
    "                pl.col(column)\n",
    "                .cast(\n",
    "                    pl.Float32,\n",
    "                    strict=False,\n",
    "                )\n",
    "            )\n",
    "        expressions.append(\n",
    "            expression.alias(column)\n",
    "        )\n",
    "    expressions.append(\n",
    "        (\n",
    "            pl.col(TARGET)\n",
    "            .cast(\n",
    "                pl.Float64,\n",
    "                strict=False,\n",
    "            )\n",
    "            .fill_null(0)\n",
    "            > 0\n",
    "        )\n",
    "        .cast(pl.Int8)\n",
    "        .alias(TARGET)\n",
    "    )\n",
    "    return data.with_columns(\n",
    "        expressions\n",
    "    )\n",
    "def load_frame(\n",
    "    path: str | Path,\n",
    "    features: list[str],\n",
    "    rules: dict,\n",
    "    max_rows: int | None = None,\n",
    "    extra_columns: list[str] | None = None,\n",
    ") -> pl.DataFrame:\n",
    "    columns = unique_list([\n",
    "        *features,\n",
    "        TARGET,\n",
    "        *(extra_columns or []),\n",
    "    ])\n",
    "    data = load_columns(\n",
    "        path,\n",
    "        columns,\n",
    "        max_rows,\n",
    "    )\n",
    "    return preprocess(\n",
    "        data,\n",
    "        features,\n",
    "        rules,\n",
    "    )\n",
    "def prepare_pandas(\n",
    "    data: pl.DataFrame,\n",
    "    features: list[str],\n",
    "    categorical_features: list[str],\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"\n",
    "    CatBoost 1.2.7 не принимает\n",
    "    Polars напрямую.\n",
    "    \"\"\"\n",
    "    frame = (\n",
    "        data\n",
    "        .select(features)\n",
    "        .to_pandas()\n",
    "    )\n",
    "    categorical_set = set(\n",
    "        categorical_features\n",
    "    )\n",
    "    cat_columns = [\n",
    "        column\n",
    "        for column in features\n",
    "        if column in categorical_set\n",
    "    ]\n",
    "    num_columns = [\n",
    "        column\n",
    "        for column in features\n",
    "        if column not in categorical_set\n",
    "    ]\n",
    "    for column in cat_columns:\n",
    "        frame[column] = (\n",
    "            frame[column]\n",
    "            .astype(\"object\")\n",
    "            .where(\n",
    "                frame[column].notna(),\n",
    "                MISSING_CAT,\n",
    "            )\n",
    "            .astype(str)\n",
    "        )\n",
    "    for column in num_columns:\n",
    "        frame[column] = (\n",
    "            pd.to_numeric(\n",
    "                frame[column],\n",
    "                errors=\"coerce\",\n",
    "            )\n",
    "            .astype(np.float32)\n",
    "        )\n",
    "    return frame\n",
    "def make_pool(\n",
    "    data: pl.DataFrame,\n",
    "    features: list[str],\n",
    "    categorical_features: list[str],\n",
    ") -> Pool:\n",
    "    return Pool(\n",
    "        data=prepare_pandas(\n",
    "            data,\n",
    "            features,\n",
    "            categorical_features,\n",
    "        ),\n",
    "        label=(\n",
    "            to_target(data)\n",
    "            if TARGET in data.columns\n",
    "            else None\n",
    "        ),\n",
    "        cat_features=[\n",
    "            column\n",
    "            for column\n",
    "            in categorical_features\n",
    "            if column in features\n",
    "        ],\n",
    "        feature_names=features,\n",
    "    )\n",
    "def predict_batched(\n",
    "    model: CatBoostClassifier,\n",
    "    data: pl.DataFrame,\n",
    "    features: list[str],\n",
    "    categorical_features: list[str],\n",
    "    batch_size: int = PREDICT_BATCH,\n",
    ") -> np.ndarray:\n",
    "    scores = np.empty(\n",
    "        data.height,\n",
    "        dtype=np.float32,\n",
    "    )\n",
    "    for start in range(\n",
    "        0,\n",
    "        data.height,\n",
    "        batch_size,\n",
    "    ):\n",
    "        stop = min(\n",
    "            start + batch_size,\n",
    "            data.height,\n",
    "        )\n",
    "        batch = data.slice(\n",
    "            start,\n",
    "            stop - start,\n",
    "        )\n",
    "        pool = make_pool(\n",
    "            batch,\n",
    "            features,\n",
    "            categorical_features,\n",
    "        )\n",
    "        scores[start:stop] = (\n",
    "            model.predict_proba(\n",
    "                pool\n",
    "            )[:, 1]\n",
    "        )\n",
    "        del batch, pool\n",
    "    return scores\n",
    "def calculate_scale_pos_weight(\n",
    "    target: np.ndarray,\n",
    ") -> float:\n",
    "    target = np.asarray(\n",
    "        target,\n",
    "        dtype=np.int8,\n",
    "    )\n",
    "    positive = int(\n",
    "        target.sum()\n",
    "    )\n",
    "    negative = (\n",
    "        len(target)\n",
    "        - positive\n",
    "    )\n",
    "    if positive == 0:\n",
    "        return 1.0\n",
    "    return float(\n",
    "        np.clip(\n",
    "            np.sqrt(\n",
    "                negative / positive\n",
    "            ),\n",
    "            1.0,\n",
    "            WEIGHT_CAP,\n",
    "        )\n",
    "    )\n",
    "def fit_catboost(\n",
    "    params: dict,\n",
    "    train_pool: Pool,\n",
    "    valid_pool: Pool | None = None,\n",
    "    early_stopping: int | None = None,\n",
    ") -> CatBoostClassifier:\n",
    "    model_params = {\n",
    "        **params,\n",
    "        \"task_type\":\n",
    "            TASK_TYPE,\n",
    "    }\n",
    "    if TASK_TYPE == \"GPU\":\n",
    "        model_params[\n",
    "            \"devices\"\n",
    "        ] = GPU_DEVICE\n",
    "    model = CatBoostClassifier(\n",
    "        **model_params\n",
    "    )\n",
    "    fit_params = {\n",
    "        \"X\":\n",
    "            train_pool,\n",
    "        \"use_best_model\":\n",
    "            valid_pool is not None,\n",
    "    }\n",
    "    if valid_pool is not None:\n",
    "        fit_params[\n",
    "            \"eval_set\"\n",
    "        ] = valid_pool\n",
    "        if early_stopping is not None:\n",
    "            fit_params[\n",
    "                \"early_stopping_rounds\"\n",
    "            ] = early_stopping\n",
    "    model.fit(\n",
    "        **fit_params\n",
    "    )\n",
    "    return model"
   ]
