    "# ============================================================\n",
    "# 4. FEATURE PROFILING\n",
    "# ============================================================\n",
    "NUMERIC_TYPES = {\n",
    "    pl.Int8,\n",
    "    pl.Int16,\n",
    "    pl.Int32,\n",
    "    pl.Int64,\n",
    "    pl.UInt8,\n",
    "    pl.UInt16,\n",
    "    pl.UInt32,\n",
    "    pl.UInt64,\n",
    "    pl.Float32,\n",
    "    pl.Float64,\n",
    "    pl.Decimal,\n",
    "    pl.Boolean,\n",
    "}\n",
    "FLOAT_TYPES = {\n",
    "    pl.Float32,\n",
    "    pl.Float64,\n",
    "}\n",
    "STRING_TYPES = {\n",
    "    pl.String,\n",
    "    pl.Categorical,\n",
    "    pl.Enum,\n",
    "}\n",
    "DATE_TYPES = {\n",
    "    pl.Date,\n",
    "    pl.Datetime,\n",
    "}\n",
    "def base_dtype(dtype):\n",
    "    if hasattr(dtype, \"base_type\"):\n",
    "        return dtype.base_type()\n",
    "    return dtype\n",
    "def is_numeric(dtype) -> bool:\n",
    "    return base_dtype(dtype) in NUMERIC_TYPES\n",
    "def is_float(dtype) -> bool:\n",
    "    return base_dtype(dtype) in FLOAT_TYPES\n",
    "def is_string(dtype) -> bool:\n",
    "    return base_dtype(dtype) in STRING_TYPES\n",
    "def is_date(dtype) -> bool:\n",
    "    return base_dtype(dtype) in DATE_TYPES\n",
    "def missing_expr(\n",
    "    column: str,\n",
    ") -> pl.Expr:\n",
    "    normalized = (\n",
    "        pl.col(column)\n",
    "        .cast(\n",
    "            pl.String,\n",
    "            strict=False,\n",
    "        )\n",
    "        .str.strip_chars()\n",
    "    )\n",
    "    return (\n",
    "        pl.col(column).is_null()\n",
    "        | normalized.is_in(MISSING)\n",
    "    ).fill_null(True)\n",
    "def normalize_preprocess_rules(\n",
    "    rules: dict,\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Поддерживает старые и промежуточные форматы\n",
    "    preprocess_rules.json.\n",
    "    \"\"\"\n",
    "    numeric = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"numeric_features\",\n",
    "            \"numeric\",\n",
    "            default=[],\n",
    "        )\n",
    "    )\n",
    "    pseudo_numeric = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"pseudo_numeric_features\",\n",
    "            \"pseudo_numeric\",\n",
    "            default=[],\n",
    "        )\n",
    "    )\n",
    "    dates = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"date_features\",\n",
    "            \"dates\",\n",
    "            default=[],\n",
    "        )\n",
    "    )\n",
    "    categorical = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"categorical_features\",\n",
    "            \"string_features\",\n",
    "            default=[],\n",
    "        )\n",
    "    )\n",
    "    pseudo_categorical = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"pseudo_categorical_features\",\n",
    "            \"pseudo_categorical\",\n",
    "            default=[],\n",
    "        )\n",
    "    )\n",
    "    catboost_categorical = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"catboost_categorical_features\",\n",
    "            \"categorical\",\n",
    "            \"cat_features\",\n",
    "            default=(\n",
    "                categorical\n",
    "                + pseudo_categorical\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "    all_features = unique_list(\n",
    "        first_nonempty(\n",
    "            rules,\n",
    "            \"all_features\",\n",
    "            \"feature_columns\",\n",
    "            \"features\",\n",
    "            default=(\n",
    "                numeric\n",
    "                + pseudo_numeric\n",
    "                + dates\n",
    "                + catboost_categorical\n",
    "            ),\n",
    "        )\n",
    "    )\n",
    "    if not all_features:\n",
    "        raise ValueError(\n",
    "            \"В preprocess_rules.json отсутствует \"\n",
    "            \"список признаков. \"\n",
    "            f\"Доступные ключи: {sorted(rules)}\"\n",
    "        )\n",
    "    if not categorical:\n",
    "        pseudo_set = set(\n",
    "            pseudo_categorical\n",
    "        )\n",
    "        categorical = [\n",
    "            feature\n",
    "            for feature in catboost_categorical\n",
    "            if feature not in pseudo_set\n",
    "        ]\n",
    "    return {\n",
    "        \"numeric_features\":\n",
    "            numeric,\n",
    "        \"pseudo_numeric_features\":\n",
    "            pseudo_numeric,\n",
    "        \"date_features\":\n",
    "            dates,\n",
    "        \"categorical_features\":\n",
    "            categorical,\n",
    "        \"pseudo_categorical_features\":\n",
    "            pseudo_categorical,\n",
    "        \"all_features\":\n",
    "            all_features,\n",
    "        \"catboost_categorical_features\":\n",
    "            catboost_categorical,\n",
    "        \"automatically_dropped\":\n",
    "            unique_list(\n",
    "                first_nonempty(\n",
    "                    rules,\n",
    "                    \"automatically_dropped\",\n",
    "                    \"dropped_features\",\n",
    "                    default=[],\n",
    "                )\n",
    "            ),\n",
    "    }\n",
    "def build_preprocess_rules(\n",
    "    path: str | Path,\n",
    ") -> dict:\n",
    "    schema = get_schema(path)\n",
    "    excluded = set(\n",
    "        INFO\n",
    "        + [TARGET]\n",
    "        + DROP\n",
    "    )\n",
    "    candidates = [\n",
    "        column\n",
    "        for column in schema\n",
    "        if column not in excluded\n",
    "    ]\n",
    "    profile_rows = []\n",
    "    for start in range(\n",
    "        0,\n",
    "        len(candidates),\n",
    "        PROFILE_BATCH,\n",
    "    ):\n",
    "        batch_columns = candidates[\n",
    "            start:start + PROFILE_BATCH\n",
    "        ]\n",
    "        batch = load_columns(\n",
    "            path,\n",
    "            batch_columns,\n",
    "            PROFILE_ROWS,\n",
    "        )\n",
    "        for column in batch_columns:\n",
    "            series = batch[column]\n",
    "            dtype = schema[column]\n",
    "            if is_string(dtype):\n",
    "                normalized = (\n",
    "                    series\n",
    "                    .cast(\n",
    "                        pl.String,\n",
    "                        strict=False,\n",
    "                    )\n",
    "                    .str.strip_chars()\n",
    "                )\n",
    "                missing = (\n",
    "                    series.is_null()\n",
    "                    | normalized.is_in(MISSING)\n",
    "                ).fill_null(True)\n",
    "                unique_count = (\n",
    "                    normalized\n",
    "                    .filter(~missing)\n",
    "                    .n_unique()\n",
    "                )\n",
    "            elif is_float(dtype):\n",
    "                missing = (\n",
    "                    series.is_null()\n",
    "                    | series.is_nan()\n",
    "                ).fill_null(True)\n",
    "                unique_count = (\n",
    "                    series\n",
    "                    .filter(~missing)\n",
    "                    .n_unique()\n",
    "                )\n",
    "            else:\n",
    "                missing = (\n",
    "                    series\n",
    "                    .is_null()\n",
    "                    .fill_null(True)\n",
    "                )\n",
    "                unique_count = (\n",
    "                    series\n",
    "                    .filter(~missing)\n",
    "                    .n_unique()\n",
    "                )\n",
    "            profile_rows.append({\n",
    "                \"feature\":\n",
    "                    column,\n",
    "                \"dtype\":\n",
    "                    str(dtype),\n",
    "                \"missing_ratio\":\n",
    "                    float(missing.mean()),\n",
    "                \"nunique\":\n",
    "                    int(unique_count),\n",
    "            })\n",
    "        del batch\n",
    "        gc.collect()\n",
    "    profile = pd.DataFrame(\n",
    "        profile_rows\n",
    "    )\n",
    "    automatically_dropped = set(\n",
    "        profile.loc[\n",
    "            (\n",
    "                profile[\"missing_ratio\"]\n",
    "                > MISSING_LIMIT\n",
    "            )\n",
    "            |\n",
    "            (\n",
    "                profile[\"nunique\"]\n",
    "                <= 1\n",
    "            ),\n",
    "            \"feature\",\n",
    "        ]\n",
    "    )\n",
    "    usable = [\n",
    "        column\n",
    "        for column in candidates\n",
    "        if column not in automatically_dropped\n",
    "    ]\n",
    "    numeric_features = []\n",
    "    pseudo_numeric_features = []\n",
    "    date_features = []\n",
    "    categorical_features = []\n",
    "    pseudo_categorical_features = []\n",
    "    for column in usable:\n",
    "        dtype = schema[column]\n",
    "        if column in PSEUDO_NUM:\n",
    "            pseudo_numeric_features.append(\n",
    "                column\n",
    "            )\n",
    "        elif column in MANUAL_CAT:\n",
    "            categorical_features.append(\n",
    "                column\n",
    "            )\n",
    "        elif column in PSEUDO_CAT:\n",
    "            pseudo_categorical_features.append(\n",
    "                column\n",
    "            )\n",
    "        elif is_date(dtype):\n",
    "            date_features.append(\n",
    "                column\n",
    "            )\n",
    "        elif is_numeric(dtype):\n",
    "            numeric_features.append(\n",
    "                column\n",
    "            )\n",
    "        else:\n",
    "            categorical_features.append(\n",
    "                column\n",
    "            )\n",
    "    all_features = (\n",
    "        numeric_features\n",
    "        + pseudo_numeric_features\n",
    "        + date_features\n",
    "        + categorical_features\n",
    "        + pseudo_categorical_features\n",
    "    )\n",
    "    catboost_categorical_features = (\n",
    "        categorical_features\n",
    "        + pseudo_categorical_features\n",
    "    )\n",
    "    rules = {\n",
    "        \"numeric_features\":\n",
    "            numeric_features,\n",
    "        \"pseudo_numeric_features\":\n",
    "            pseudo_numeric_features,\n",
    "        \"date_features\":\n",
    "            date_features,\n",
    "        \"categorical_features\":\n",
    "            categorical_features,\n",
    "        \"pseudo_categorical_features\":\n",
    "            pseudo_categorical_features,\n",
    "        \"all_features\":\n",
    "            all_features,\n",
    "        \"catboost_categorical_features\":\n",
    "            catboost_categorical_features,\n",
    "        \"automatically_dropped\":\n",
    "            sorted(automatically_dropped),\n",
    "    }\n",
    "    profile.to_csv(\n",
    "        PROFILE_PATH,\n",
    "        index=False,\n",
    "    )\n",
    "    save_json(\n",
    "        RULES_PATH,\n",
    "        rules,\n",
    "    )\n",
    "    print(\n",
    "        f\"[PROFILE] Всего признаков: \"\n",
    "        f\"{len(all_features)}\\n\"\n",
    "        f\"[PROFILE] Категориальных: \"\n",
    "        f\"{len(catboost_categorical_features)}\\n\"\n",
    "        f\"[PROFILE] Исключено: \"\n",
    "        f\"{len(automatically_dropped)}\"\n",
    "    )\n",
    "    return rules\n",
    "def get_preprocess_rules() -> dict:\n",
    "    if (\n",
    "        RULES_PATH.exists()\n",
    "        and not FORCE_PROFILE\n",
    "    ):\n",
    "        try:\n",
    "            with RULES_PATH.open(\n",
    "                encoding=\"utf-8\"\n",
    "            ) as file:\n",
    "                saved_rules = json.load(\n",
    "                    file\n",
    "                )\n",
    "            rules = (\n",
    "                normalize_preprocess_rules(\n",
    "                    saved_rules\n",
    "                )\n",
    "            )\n",
    "            if rules != saved_rules:\n",
    "                save_json(\n",
    "                    RULES_PATH,\n",
    "                    rules,\n",
    "                )\n",
    "                print(\n",
    "                    \"[PROFILE] Правила приведены \"\n",
    "                    \"к нормализованному формату.\"\n",
    "                )\n",
    "            else:\n",
    "                print(\n",
    "                    \"[PROFILE] Загружены \"\n",
    "                    \"сохранённые правила.\"\n",
    "                )\n",
    "            return rules\n",
    "        except (\n",
    "            OSError,\n",
    "            json.JSONDecodeError,\n",
    "            ValueError,\n",
    "        ) as error:\n",
    "            print(\n",
    "                \"[PROFILE] Сохранённые правила \"\n",
    "                f\"не удалось загрузить: {error}\\n\"\n",
    "                \"[PROFILE] Профиль будет \"\n",
    "                \"рассчитан заново.\"\n",
    "            )\n",
    "    return build_preprocess_rules(\n",
    "        PATHS[\"train\"]\n",
    "    )"
