   "source": [
    "# ============================================================\n",
    "# 14. REPORTS\n",
    "# ============================================================\n",
    "point_report = pd.DataFrame(\n",
    "    point_rows\n",
    ")\n",
    "bootstrap_report = pd.concat(\n",
    "    bootstrap_parts,\n",
    "    ignore_index=True,\n",
    ")\n",
    "point_report.to_csv(\n",
    "    OUT\n",
    "    / \"metrics_point_report.csv\",\n",
    "    index=False,\n",
    ")\n",
    "bootstrap_report.to_csv(\n",
    "    OUT\n",
    "    / \"metrics_bootstrap_ci.csv\",\n",
    "    index=False,\n",
    ")\n",
    "final_report = (\n",
    "    point_report\n",
    "    .melt(\n",
    "        id_vars=[\n",
    "            \"sample\",\n",
    "            \"target_col\",\n",
    "            \"rows\",\n",
    "            \"positive_cnt\",\n",
    "            \"target_rate\",\n",
    "        ],\n",
    "        value_vars=[\n",
    "            \"roc_auc\",\n",
    "            \"gini\",\n",
    "            \"pr_auc\",\n",
    "        ],\n",
    "        var_name=\n",
    "            \"metric\",\n",
    "        value_name=\n",
    "            \"point_estimate\",\n",
    "    )\n",
    "    .merge(\n",
    "        bootstrap_report,\n",
    "        on=[\n",
    "            \"sample\",\n",
    "            \"metric\",\n",
    "        ],\n",
    "        how=\"left\",\n",
    "    )\n",
    "    .sort_values([\n",
    "        \"sample\",\n",
    "        \"metric\",\n",
    "    ])\n",
    ")\n",
    "threshold_report = (\n",
    "    point_report[[\n",
    "        \"sample\",\n",
    "        \"threshold\",\n",
    "        \"recall\",\n",
    "        \"precision\",\n",
    "        \"f1\",\n",
    "        \"predicted_rate\",\n",
    "        \"top_share\",\n",
    "        \"top_target_rate\",\n",
    "        \"lift_top_share\",\n",
    "        \"psi_vs_train\",\n",
    "    ]]\n",
    ")\n",
    "final_report.to_csv(\n",
    "    OUT\n",
    "    / \"final_model_report.csv\",\n",
    "    index=False,\n",
    ")\n",
    "threshold_report.to_csv(\n",
    "    OUT\n",
    "    / \"threshold_metrics.csv\",\n",
    "    index=False,\n",
    ")"
   ]
  },
