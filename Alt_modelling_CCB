    "# ============================================================\n",
    "# 9. METRICS\n",
    "# ============================================================\n",
    "def ranking_metrics(\n",
    "    target: np.ndarray,\n",
    "    score: np.ndarray,\n",
    ") -> dict:\n",
    "    target = np.asarray(\n",
    "        target,\n",
    "        dtype=np.int8,\n",
    "    )\n",
    "    score = np.asarray(\n",
    "        score,\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "    if (\n",
    "        np.unique(\n",
    "            target\n",
    "        ).size\n",
    "        < 2\n",
    "    ):\n",
    "        roc_auc = np.nan\n",
    "        pr_auc = np.nan\n",
    "    else:\n",
    "        roc_auc = float(\n",
    "            roc_auc_score(\n",
    "                target,\n",
    "                score,\n",
    "            )\n",
    "        )\n",
    "        pr_auc = float(\n",
    "            average_precision_score(\n",
    "                target,\n",
    "                score,\n",
    "            )\n",
    "        )\n",
    "    return {\n",
    "        \"rows\":\n",
    "            len(target),\n",
    "        \"positive_cnt\":\n",
    "            int(\n",
    "                target.sum()\n",
    "            ),\n",
    "        \"target_rate\":\n",
    "            float(\n",
    "                target.mean()\n",
    "            ),\n",
    "        \"roc_auc\":\n",
    "            roc_auc,\n",
    "        \"gini\":\n",
    "            (\n",
    "                2 * roc_auc - 1\n",
    "                if np.isfinite(\n",
    "                    roc_auc\n",
    "                )\n",
    "                else np.nan\n",
    "            ),\n",
    "        \"pr_auc\":\n",
    "            pr_auc,\n",
    "        \"score_mean\":\n",
    "            float(\n",
    "                score.mean()\n",
    "            ),\n",
    "        \"score_std\":\n",
    "            float(\n",
    "                score.std()\n",
    "            ),\n",
    "        \"score_min\":\n",
    "            float(\n",
    "                score.min()\n",
    "            ),\n",
    "        \"score_max\":\n",
    "            float(\n",
    "                score.max()\n",
    "            ),\n",
    "    }\n",
    "def threshold_metrics(\n",
    "    target: np.ndarray,\n",
    "    score: np.ndarray,\n",
    ") -> dict:\n",
    "    target = np.asarray(\n",
    "        target,\n",
    "        dtype=np.int8,\n",
    "    )\n",
    "    score = np.asarray(\n",
    "        score,\n",
    "        dtype=np.float64,\n",
    "    )\n",
    "    predicted = (\n",
    "        score\n",
    "        >= THRESHOLD\n",
    "    )\n",
    "    true_positive = np.count_nonzero(\n",
    "        (target == 1)\n",
    "        & predicted\n",
    "    )\n",
    "    false_positive = np.count_nonzero(\n",
    "        (target == 0)\n",
    "        & predicted\n",
    "    )\n",
    "    false_negative = np.count_nonzero(\n",
    "        (target == 1)\n",
    "        & ~predicted\n",
    "    )\n",
    "    recall_denominator = (\n",
    "        true_positive\n",
    "        + false_negative\n",
    "    )\n",
    "    precision_denominator = (\n",
    "        true_positive\n",
    "        + false_positive\n",
    "    )\n",
    "    recall = (\n",
    "        true_positive\n",
    "        / recall_denominator\n",
    "        if recall_denominator\n",
    "        else 0.0\n",
    "    )\n",
    "    precision = (\n",
    "        true_positive\n",
    "        / precision_denominator\n",
    "        if precision_denominator\n",
    "        else 0.0\n",
    "    )\n",
    "    f1 = (\n",
    "        2\n",
    "        * precision\n",
    "        * recall\n",
    "        / (\n",
    "            precision\n",
    "            + recall\n",
    "        )\n",
    "        if (\n",
    "            precision\n",
    "            + recall\n",
    "        )\n",
    "        else 0.0\n",
    "    )\n",
    "    top_count = max(\n",
    "        1,\n",
    "        int(\n",
    "            np.ceil(\n",
    "                len(score)\n",
    "                * TOP_SHARE\n",
    "            )\n",
    "        ),\n",
    "    )\n",
    "    top_indices = np.argpartition(\n",
    "        score,\n",
    "        -top_count,\n",
    "    )[-top_count:]\n",
    "    target_rate = float(\n",
    "        target.mean()\n",
    "    )\n",
    "    top_target_rate = float(\n",
    "        target[\n",
    "            top_indices\n",
    "        ].mean()\n",
    "    )\n",
    "    return {\n",
    "        \"threshold\":\n",
    "            THRESHOLD,\n",
    "        \"recall\":\n",
    "            float(recall),\n",
    "        \"precision\":\n",
    "            float(precision),\n",
    "        \"f1\":\n",
    "            float(f1),\n",
    "        \"predicted_rate\":\n",
    "            float(\n",
    "                predicted.mean()\n",
    "            ),\n",
    "        \"top_share\":\n",
    "            TOP_SHARE,\n",
    "        \"top_target_rate\":\n",
    "            top_target_rate,\n",
    "        \"lift_top_share\":\n",
    "            (\n",
    "                top_target_rate\n",
    "                / target_rate\n",
    "                if target_rate > 0\n",
    "                else np.nan\n",
    "            ),\n",
    "    }"
   ]
