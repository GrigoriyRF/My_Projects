    "# ============================================================\n",
    "# 8. OPTUNA 4.0 — ANTI-OVERFIT REFINEMENT + JOURNAL STORAGE ON NFS\n",
    "# ============================================================\n",
    "\n",
    "feature_signature = (\n",
    "    hashlib.sha256(\n",
    "        \"\\n\".join(selected_features).encode(\"utf-8\")\n",
    "    ).hexdigest()\n",
    ")\n",
    "\n",
    "# Fallback на параметры первого поиска со скриншота.\n",
    "# Если results_v_4/best_trial.json существует, значения из него имеют приоритет.\n",
    "BASELINE_DEFAULT_PARAMS = {\n",
    "    \"bootstrap_type\": \"Bernoulli\",\n",
    "    \"iterations\": 1900,\n",
    "    \"learning_rate\": 0.05080280553,\n",
    "    \"depth\": 6,\n",
    "    \"l2_leaf_reg\": 55.54683131393669,\n",
