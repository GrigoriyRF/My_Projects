    "    shap_ranking.to_csv(\n",
    "        OUT\n",
    "        / \"shap_feature_ranking.csv\",\n",
    "        index=False,\n",
    "    )\n",
    "    save_json(\n",
    "        FEATURES_PATH,\n",
    "        {\n",
    "            \"selected_features\":\n",
