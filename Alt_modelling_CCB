    "# ============================================================\n",
    "# 3. COMMON UTILS\n",
    "# ============================================================\n",
    "def save_json(path: Path, data: dict) -> None:\n",
    "    \"\"\"Атомарно сохраняет JSON.\"\"\"\n",
    "    tmp = path.with_suffix(path.suffix + \".tmp\")\n",
    "    with tmp.open(\"w\", encoding=\"utf-8\") as file:\n",
    "        json.dump(\n",
    "            data,\n",
    "            file,\n",
    "            ensure_ascii=False,\n",
    "            indent=2,\n",
    "        )\n",
    "    tmp.replace(path)\n",
    "def release(*variable_names: str) -> None:\n",
    "    \"\"\"Удаляет глобальные переменные, если они существуют, и запускает GC.\"\"\"\n",
    "    namespace = globals()\n",
    "    for name in variable_names:\n",
    "        namespace.pop(name, None)\n",
    "    gc.collect()\n",
    "def unique_list(values) -> list[str]:\n",
    "    return list(dict.fromkeys(values or []))\n",
    "def first_nonempty(\n",
    "    mapping: dict,\n",
    "    *keys: str,\n",
    "    default=None,\n",
    "):\n",
    "    \"\"\"Первое непустое значение из перечисленных ключей.\"\"\"\n",
    "    for key in keys:\n",
    "        value = mapping.get(key)\n",
    "        if value:\n",
    "            return value\n",
    "    return default\n",
    "def parquet_source(path: str | Path) -> str:\n",
    "    path = Path(path)\n",
    "    if path.is_dir():\n",
    "        return str(path / \"**\" / \"*.parquet\")\n",
    "    return str(path)\n",
    "def scan_parquet(path: str | Path) -> pl.LazyFrame:\n",
    "    return pl.scan_parquet(\n",
    "        parquet_source(path),\n",
    "        hive_partitioning=False,\n",
    "    )\n",
    "def collect_streaming(\n",
    "    lazy_frame: pl.LazyFrame,\n",
    ") -> pl.DataFrame:\n",
    "    return lazy_frame.collect(streaming=True)\n",
    "@lru_cache(maxsize=None)\n",
    "def get_schema(path: str | Path) -> dict:\n",
    "    return dict(\n",
    "        scan_parquet(path).collect_schema()\n",
    "    )\n",
    "@lru_cache(maxsize=None)\n",
    "def get_row_count(path: str | Path) -> int:\n",
    "    return int(\n",
    "        collect_streaming(\n",
    "            scan_parquet(path)\n",
    "            .select(\n",
    "                pl.len().alias(\"rows\")\n",
    "            )\n",
    "        )[\"rows\"][0]\n",
    "    )\n",
    "def load_columns(\n",
    "    path: str | Path,\n",
    "    columns: list[str],\n",
    "    max_rows: int | None = None,\n",
    ") -> pl.DataFrame:\n",
    "    schema = get_schema(path)\n",
    "    columns = [\n",
    "        column\n",
    "        for column in dict.fromkeys(columns)\n",
    "        if column in schema\n",
    "    ]\n",
    "    if not columns:\n",
    "        raise ValueError(\n",
    "            f\"В источнике отсутствуют нужные столбцы: {path}\"\n",
    "        )\n",
    "\n",
    "    lazy_frame = scan_parquet(path).select(columns)\n",
    "\n",
    "    if max_rows is None:\n",
    "        return collect_streaming(lazy_frame)\n",
    "\n",
    "    rows = get_row_count(path)\n",
    "    if rows <= max_rows:\n",
    "        return collect_streaming(lazy_frame)\n",
    "\n",
    "    # Ровно max_rows строк, детерминированно и равномерно по всему датасету.\n",
    "    row_idx = pl.col(\"_row_number\").cast(pl.Int64)\n",
    "    sampled = (\n",
    "        lazy_frame\n",
    "        .with_row_index(\"_row_number\")\n",
    "        .filter(\n",
    "            (((row_idx + 1) * max_rows) // rows)\n",
    "            > ((row_idx * max_rows) // rows)\n",
    "        )\n",
    "        .drop(\"_row_number\")\n",
    "    )\n",
    "\n",
    "    return collect_streaming(sampled)\n",
    "def to_target(\n",
    "    data: pl.DataFrame,\n",
    ") -> np.ndarray:\n",
    "    return (\n",
    "        data[TARGET]\n",
    "        .to_numpy()\n",
    "        .astype(\n",
    "            np.int8,\n",
    "            copy=False,\n",
    "        )\n",
    "    )\n",
    "def gini_from_scores(\n",
    "    target: np.ndarray,\n",
    "    score: np.ndarray,\n",
    ") -> float:\n",
    "    return float(\n",
    "        2 * roc_auc_score(target, score) - 1\n",
    "    )"
   ]
